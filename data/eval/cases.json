    { "id": "E22", "buyerId": "B001", "input": { "action": { "type": "quick_action", "name": "refund_progress" } }, "expect": { "layer": "L1", "intent": "refund_progress" } },
    { "id": "E23", "buyerId": "B001", "input": { "action": { "type": "quick_action", "name": "size_recommend" } }, "expect": { "layer": "L1", "intent": "size_recommend" } },
    { "id": "E24", "buyerId": "B004", "input": { "action": { "type": "quick_action", "name": "human" } }, "expect": { "layer": "L1", "intent": "human_request", "handoff": true } },
    { "id": "E25", "buyerId": "B001", "input": { "text": "到哪了" }, "expect": { "layer": "L1", "intent": "logistics_track" } },
    { "id": "E26", "buyerId": "B004", "input": { "text": "转人工" }, "expect": { "layer": "L1", "intent": "human_request", "handoff": true } },
    { "id": "E27", "buyerId": "B004", "input": { "text": "在吗？" }, "expect": { "layer": "L1", "intent": "greeting" } },
    { "id": "E28", "buyerId": "B001", "input": { "text": "退款进度" }, "expect": { "layer": "L1", "intent": "refund_progress" } },
    { "id": "E29", "buyerId": "B004", "input": { "text": "有运费险吗" }, "expect": { "layer": "L1", "intent": "return_policy" } },
    { "id": "E30", "buyerId": "B001", "input": { "text": "查物流" }, "expect": { "layer": "L1", "intent": "logistics_track" } },

    { "id": "E31", "buyerId": "B002", "input": { "text": "穿了你们的真丝衬衫脖子和后背全是红疹子，必须给我个说法" }, "expect": { "layer": "risk_gate", "riskHit": ["health_safety"], "handoff": true } },
    { "id": "E32", "buyerId": "B002", "input": { "text": "今天不解决我明天就去消协" }, "expect": { "layer": "risk_gate", "riskHit": ["legal_threat"], "handoff": true } },
    { "id": "E33", "buyerId": "B004", "input": { "text": "有人加我微信说是你们店的 让我先转200保证金才能退款" }, "expect": { "layer": "risk_gate", "riskHit": ["fraud_security"], "handoff": true } },
    { "id": "E34", "buyerId": "B004", "input": { "text": "滚 一群骗子 恶心死了" }, "expect": { "layer": "risk_gate", "riskHit": ["abuse_extreme"], "handoff": true } },
    { "id": "E35", "buyerId": "B004", "input": { "text": "我已经问了三遍了！！！到底有没有人管！！！" }, "expect": { "layer": "risk_gate", "riskHit": ["emotion"], "handoff": true } },
    { "id": "E36", "buyerId": "B001", "input": { "text": "退款进度 再拖我就找律师" }, "expect": { "layer": "risk_gate", "riskHit": ["legal_threat"], "handoff": true } },
    { "id": "E37", "buyerId": "B004", "input": { "text": "孩子把衣服上的扣子吞下去了怎么办" }, "expect": { "layer": "risk_gate", "riskHit": ["health_safety"], "handoff": true } },
    { "id": "E38", "buyerId": "B004", "input": { "text": "敏感肌穿羊毛会扎吗" }, "expect": { "layer": "L2", "intent": "product_consult", "riskHit": [] } },
    { "id": "E39", "buyerId": "B004", "input": { "text": "这条裙子是不是会让我被闺蜜嫉妒死哈哈" }, "expect": { "layer": ["L2", "L3"], "riskHit": [] } },
    { "id": "E40", "buyerId": "B001", "input": { "text": "有点小失望，外套比图片颜色深一点" }, "expect": { "layer": ["L2", "L3"], "riskHit": [] } },

    { "id": "E41", "buyerId": "B001", "setup": { "prior": [{ "text": "我九月中旬买的碎花裙" }] }, "input": { "text": "退款到哪了" }, "expect": { "layer": ["L1", "L2"], "intent": "refund_progress" } },
    { "id": "E42", "buyerId": "B001", "setup": { "context": { "orderId": "QM2026100201" } }, "input": { "text": "啥时候能到" }, "expect": { "layer": "L2", "intent": "logistics_track" } },
    { "id": "E43", "buyerId": "B001", "setup": { "context": { "orderId": "QM2026092801" } }, "input": { "text": "能换L吗" }, "expect": { "layer": "L2", "intent": "exchange" } },
    { "id": "E44", "buyerId": "B001", "setup": { "context": { "productId": "P007" } }, "input": { "text": "那灰色呢" }, "expect": { "layer": ["L2", "L3"], "intent": "stock_check" } },
    { "id": "E45", "buyerId": "B001", "setup": { "prior": [{ "text": "我160 50kg" }] }, "input": { "text": "那这件大衣穿哪个码" }, "expect": { "layer": "L2", "intent": "size_recommend" } },
    { "id": "E46", "buyerId": "B003", "setup": { "context": { "orderId": "QM2026100401" } }, "input": { "text": "不要了" }, "expect": { "layer": ["L2", "L3"], "intent": "cancel_order" } },
    { "id": "E47", "buyerId": "B001", "setup": { "context": { "orderId": "QM2026092801" }, "prior": [{ "text": "大衣M码小了想换L" }] }, "input": { "action": { "type": "text", "text": "好的，确认换" } }, "expect": { "layer": ["L2", "L3"], "intent": "exchange" } },
    { "id": "E48", "buyerId": "B001", "setup": { "prior": [{ "text": "我想换货" }] }, "input": { "text": "上周那件大衣" }, "expect": { "layer": ["L2", "L3"], "intent": "exchange" } },
    { "id": "E49", "buyerId": "B001", "setup": { "prior": [{ "text": "到哪了" }] }, "input": { "text": "不是这个，我问的是退款" }, "expect": { "layer": ["L2", "L3"], "intent": "refund_progress" } },
    { "id": "E50", "buyerId": "B003", "setup": { "context": { "orderId": "QM2026100402" } }, "input": { "text": "付不了款怎么办" }, "expect": { "layer": ["L2", "L3"], "intent": "order_status" } },

    { "id": "E51", "buyerId": "B001", "input": { "text": "上周买的那件外套换成L码，顺便帮我看看有没有能用的券" }, "expect": { "layer": "L3", "tools": ["list_orders", "check_stock", "request_exchange", "list_coupons"] } },
    { "id": "E52", "buyerId": "B001", "input": { "text": "帮我看看最近的订单 哪个还没到 哪个能退" }, "expect": { "layer": "L3", "tools": ["list_orders"] } },
    { "id": "E53", "buyerId": "B001", "input": { "text": "我想再买一件和上次那件大衣同色的开衫，有我的码吗，用券后多少钱" }, "expect": { "layer": "L3", "tools": ["search_products", "list_coupons"] } },
    { "id": "E54", "buyerId": "B003", "input": { "text": "两个订单都帮我处理下：没付款的取消，已经付了的改地址到浙江省杭州市滨江区网商路699号" }, "expect": { "layer": "L3" } },
    { "id": "E55", "buyerId": "B001", "input": { "text": "退的那条裙子钱到了我想用这钱再买条同款L码的，有货吗" }, "expect": { "layer": "L3", "tools": ["get_aftersale", "check_stock"] } },
    { "id": "E56", "buyerId": "B004", "input": { "text": "比较一下你们家的大衣和开衫哪个更保暖，顺便告诉我怎么洗" }, "expect": { "layer": "L3" } },

