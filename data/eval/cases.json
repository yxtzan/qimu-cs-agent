{
  "_readme": [
    "T06 端到端评测集，由 Claude 编写，Agent 不得修改。",
    "每条 case：从全新会话开始（每条前重置 runtime 数据），先依次执行 setup.prior（可以是 text 或 action），再发送 input，检查最后一条 input 的 RouteTrace。",
    "expect.layer 可以是字符串或数组（数组表示任一即可）。expect.intent 可选；expect.riskHit 为必须命中的风险项（子集即可）；expect.handoff 为是否应转人工；expect.tools 为必须调用的工具（子集即可，仅在非 mock 模式检查）。",
    "riskHit 为空数组且 layer 不是 risk_gate 的 case，用于计算风险误报率。"
  ],
  "cases": [
    { "id": "E01", "buyerId": "B001", "input": { "text": "这件大衣是纯羊毛的吗" }, "setup": { "context": { "productId": "P007" } }, "expect": { "layer": "L2", "intent": "product_consult" } },
    { "id": "E02", "buyerId": "B001", "input": { "text": "真丝的衣服可以丢洗衣机吗" }, "expect": { "layer": "L2", "intent": "product_consult" } },
    { "id": "E03", "buyerId": "B001", "input": { "text": "我160 50公斤穿什么码合适" }, "setup": { "context": { "productId": "P002" } }, "expect": { "layer": "L2", "intent": "size_recommend", "tools": ["recommend_size"] } },
    { "id": "E04", "buyerId": "B003", "input": { "text": "身高158 体重94斤 选S还是M" }, "expect": { "layer": "L2", "intent": "size_recommend" } },
    { "id": "E05", "buyerId": "B001", "input": { "text": "燕麦色L还有货不" }, "setup": { "context": { "productId": "P007" } }, "expect": { "layer": "L2", "intent": "stock_check", "tools": ["check_stock"] } },
    { "id": "E06", "buyerId": "B001", "input": { "text": "我有哪些优惠券可以用" }, "expect": { "layer": "L2", "intent": "promotion", "tools": ["list_coupons"] } },
    { "id": "E07", "buyerId": "B004", "input": { "text": "满多少包邮啊" }, "expect": { "layer": "L2", "intent": "shipping_policy" } },
    { "id": "E08", "buyerId": "B003", "input": { "text": "为啥我的订单一直是待付款 钱都扣了" }, "expect": { "layer": ["L2", "L3"], "intent": "order_status" } },
    { "id": "E09", "buyerId": "B001", "input": { "text": "我买的裤子和开衫现在到哪了" }, "expect": { "layer": "L2", "intent": "logistics_track", "tools": ["track_logistics"] } },
    { "id": "E10", "buyerId": "B003", "input": { "text": "麻烦尽快发一下货 下周出差要带" }, "expect": { "layer": "L2", "intent": "urge_shipping" } },
    { "id": "E11", "buyerId": "B003", "input": { "text": "收货地址写错了想改一下" }, "expect": { "layer": "L2", "intent": "modify_order" } },
    { "id": "E12", "buyerId": "B003", "input": { "text": "那个雾粉开衫的订单我不要了" }, "expect": { "layer": "L2", "intent": "cancel_order" } },
    { "id": "E13", "buyerId": "B001", "input": { "text": "外套不太合身 想退掉" }, "expect": { "layer": "L2", "intent": "refund_apply" } },
    { "id": "E14", "buyerId": "B001", "input": { "text": "之前退的那条裙子钱怎么还没到" }, "expect": { "layer": "L2", "intent": "refund_progress", "tools": ["get_aftersale"] } },
    { "id": "E15", "buyerId": "B001", "input": { "text": "大衣M码有点小 我想换大一码" }, "expect": { "layer": "L2", "intent": "exchange", "tools": ["request_exchange"] } },
    { "id": "E16", "buyerId": "B004", "input": { "text": "衣服有股很重的味道 洗了也没散" }, "expect": { "layer": "L2", "intent": "quality_issue" } },
    { "id": "E17", "buyerId": "B004", "input": { "text": "签收第八天了还能无理由退吗" }, "expect": { "layer": "L2", "intent": "return_policy" } },
    { "id": "E18", "buyerId": "B001", "input": { "text": "我要开个发票 个人抬头就行" }, "expect": { "layer": ["L1", "L2"], "intent": "invoice" } },
