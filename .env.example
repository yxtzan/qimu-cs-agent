# Copy this file to `.env.local` and fill in OPENROUTER_API_KEY.
# `.env.local` is gitignored — never commit a real key.

# ── OpenRouter ────────────────────────────────────────────────
# Create a key at https://openrouter.ai/settings/keys. Leave empty to run in mock mode.
OPENROUTER_API_KEY=

# ── Understanding layer (decide) ──────────────────────────────
# jev | llm | mock. Without a key the system automatically uses mock.
CLASSIFIER_PROVIDER=jev
JEV_MODEL=typesafe/jev-1.13
# Fallback classifier (JSON output, reasoning off). T01b: deepseek-v4-flash 96.7% / p50 2.6s, cheaper than qwen3.7-flash (90%, 3 errors).
CLASSIFIER_LLM_MODEL=deepseek/deepseek-v4-flash
# Keep Jev warm: cold calls take ~6s, warm ~0.4s (T01b). Ping interval in ms while the server runs; 0 = off.
JEV_KEEPALIVE_MS=120000

# ── Generation / agent / RAG ──────────────────────────────────
# handler replies (RAG answers). DeepSeek V4 Flash: $0.028/M in, $0.056/M out, 1M ctx.
GENERATION_MODEL=deepseek/deepseek-v4-flash
# L3 agent with tool calling. T05: Qwen passed both real multi-step cases within budget.
AGENT_MODEL=qwen/qwen3.7-flash
# Agent reasoning is controlled separately from LLM_REASONING.
AGENT_REASONING=off
# Multilingual embeddings. Qwen3 Embedding 8B: $0.01/M tokens, 32k ctx.
EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# ── Tuning ────────────────────────────────────────────────────
L2_CONFIDENCE_THRESHOLD=0.70
# Maximum classifier wait after a hard risk keyword; timeout keeps the keyword verdict.
KEYWORD_RISK_WAIT_MS=2500
RAG_MIN_SCORE=0.35
USD_TO_CNY=7.1

# ── Frontend ──────────────────────────────────────────────────
# 1 = frontend uses local mock data and never calls the backend.
NEXT_PUBLIC_USE_MOCK=0

# ── 公开演示（T22；不设 PUBLIC_DEMO 时维持原行为）──────────────
# 1 = 每位访客独立数据、后台上下文隔离、限流与每日额度保护；0 = 本地共享演示。
PUBLIC_DEMO=0
# 全站每日美元预算（北京时间 0 点恢复）；0 可立即验证简化模式与顶部横幅。
DAILY_BUDGET_USD=1
# 仅在可信 Caddy 代理后设置 1：取 X-Forwarded-For 最后一项作 IP 限流。
# 默认 0 不信任外部 IP 头，所有直连请求共用保守的 400 条/日上限。
PUBLIC_DEMO_TRUST_PROXY=0
